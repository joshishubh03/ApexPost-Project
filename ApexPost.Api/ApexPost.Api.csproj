<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Week 4 Part B: REST API over the Week 3 SQL Server / EF Core services (minimal hosting, no Startup.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ApexPost.Api</RootNamespace>
    <!-- Secrets (connection string) come from User Secrets in Development, never from appsettings.json. -->
    <UserSecretsId>apexpost-api-local-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
  </ItemGroup>

</Project>
