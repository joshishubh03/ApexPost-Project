{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://identity.apexpost.example",
    "Audience": "apexpost-api",
    "AccessTokenMinutes": 60
  },
  "PartnerApi": {
    "Keys": {}
  },
  "Persistence": {
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": false
  }
}
