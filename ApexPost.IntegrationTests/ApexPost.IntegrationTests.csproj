<Project Sdk="Microsoft.NET.Sdk">

  <!-- Week 5: integration tests against real infrastructure: a disposable SQL Server database (LocalDB by default,
       APEXPOST_TEST_SQLSERVER to override), the MVC app and ApexPost.Api in memory (WebApplicationFactory), the
       EF Core model and migrations, and Couchbase Lite in a temporary folder. See TESTING-STRATEGY.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Domain\ApexPost.Domain.csproj" />
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
    <ProjectReference Include="..\ApexPost.Web\ApexPost.Web.csproj" />
    <ProjectReference Include="..\ApexPost.Api\ApexPost.Api.csproj" />
    <ProjectReference Include="..\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
    <ProjectReference Include="..\ApexPost.Courier.Core\ApexPost.Courier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fake HTTP server used by the device-sync test is shared with the unit tests (one source file). -->
    <Compile Include="..\ApexPost.UnitTests\CourierClient\TestInfrastructure.cs" Link="CourierClient\TestInfrastructure.cs" />
  </ItemGroup>

</Project>
