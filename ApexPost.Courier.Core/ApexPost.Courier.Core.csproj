<Project Sdk="Microsoft.NET.Sdk">

  <!-- Week 4 Part D: platform-neutral courier app logic (typed API client, auth handler, Polly resilience, JSON
       source generation, offline sync). The MAUI app only adds UI and platform adapters (SecureStorage,
       Connectivity), so everything here is unit-testable without a device. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ApexPost.Courier.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHttpClientFactory + Polly v8 resilience pipelines. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
