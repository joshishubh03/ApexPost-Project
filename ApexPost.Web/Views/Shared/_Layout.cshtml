<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApexPost.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-xxl">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">ApexPost</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item"><a asp-controller="Catalog" asp-action="Index" class="nav-link">Catalogue</a></li>
                            <li class="nav-item"><a asp-controller="Inventory" asp-action="Index" class="nav-link">Inventory</a></li>
                            <li class="nav-item"><a asp-controller="Shipping" asp-action="Index" class="nav-link">Shipping</a></li>
                            <li class="nav-item"><a asp-controller="CounterTransactions" asp-action="Index" class="nav-link">Counter</a></li>
                            <li class="nav-item"><a asp-controller="MoneyOrders" asp-action="Index" class="nav-link">Money orders</a></li>
                            @if (User.IsInRole("Administrator") || User.IsInRole("BranchManager") || User.IsInRole("Auditor"))
                            {
                                <li class="nav-item"><a asp-controller="Reports" asp-action="Index" class="nav-link">Reports</a></li>
                            }
                            @if (User.IsInRole("Auditor"))
                            {
                                <li class="nav-item"><a asp-controller="Reports" asp-action="AuditOverview" class="nav-link">Audit overview</a></li>
                            }
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item"><a asp-controller="Administration" asp-action="Branches" class="nav-link">Branches</a></li>
                                <li class="nav-item"><a asp-controller="Administration" asp-action="Staff" class="nav-link">Staff</a></li>
                            }
                        </ul>
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 py-2 py-lg-0">
                            <span class="nav-user small text-muted">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-lg-auto py-2 py-lg-0">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Staff sign in</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-xxl site-content">
        <main role="main" class="site-main">
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer border-top text-muted">
        <div class="container-xxl py-3">
            &copy; 2026 - ApexPost Counter Platform
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
