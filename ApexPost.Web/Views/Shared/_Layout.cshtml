<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApexPost.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">ApexPost</a>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary btn-sm">Catalogue</a>
                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary btn-sm">Inventory</a>
                        <a asp-controller="Shipping" asp-action="Index" class="btn btn-outline-primary btn-sm">Shipping</a>
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-controller="Administration" asp-action="Branches" class="btn btn-outline-primary btn-sm">Branches</a>
                            <a asp-controller="Administration" asp-action="Staff" class="btn btn-outline-primary btn-sm">Staff</a>
                        }
                        <span class="text-muted small">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Staff sign in</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; 2026 - ApexPost Counter Platform
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
