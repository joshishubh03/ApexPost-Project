@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="message-card" aria-labelledby="error-heading">
    <p class="eyebrow">APEXPOST COUNTER PLATFORM</p>
    <h1 id="error-heading" class="h3">We couldn't complete that request</h1>
    <p class="text-muted">Something went wrong while processing the request. Try again, or return to the dashboard.</p>
    @if (Model.ShowRequestId)
    {
        <div class="error-reference">
            <span class="text-muted small">Request ID</span>
            <code>@Model.RequestId</code>
        </div>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to dashboard</a>
</section>
