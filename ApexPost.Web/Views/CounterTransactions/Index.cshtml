@model CounterTransactionPageModel
@using ApexPost.Domain.Enums
@{
    ViewData["Title"] = "Counter transactions";
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
}

<h1>Counter transactions</h1>
<p class="text-muted">Sell stocked products, process parcel or letter shipments, issue money orders, and take one payment.</p>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

@if (User.IsInRole("Administrator"))
{
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-5"><label for="branchId" class="form-label">Branch</label><select id="branchId" name="branchId" class="form-select"><option value="">Select a branch</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id" selected="@(branch.Id == Model.SelectedBranchId)">@branch.Code — @branch.Name</option> }</select></div>
        <div class="col-auto align-self-end"><button class="btn btn-outline-primary" type="submit">Open register</button></div>
    </form>
}

@if (Model.Register is null)
{
    <div class="alert alert-info">Select a branch to open its register.</div>
}
else
{
    <h2 class="h4">@Model.Register.Branch.Code — @Model.Register.Branch.Name</h2>
    @if (!Model.Register.Branch.IsOpen)
    {
        <div class="alert alert-warning">This branch is closed. New transactions are disabled.</div>
    }
    else if (Model.CanCreate)
    {
        <form asp-action="Complete" method="post" class="card card-body mb-4">
            <input type="hidden" name="BranchId" value="@Model.Register.Branch.Id" />
            <h3 class="h5">Create transaction</h3>
            <p class="text-muted">Enter a quantity for each item. Add a shipping service to capture recipient details and parcel dimensions.</p>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Product</th><th>Category</th><th>Tax category</th><th>Unit price</th><th>Available</th><th>Quantity</th></tr></thead>
                    <tbody>
                    @foreach (var product in Model.Register.Products)
                    {
                        <tr>
                            <td>@product.Name<br /><small class="text-muted">@product.Sku</small></td>
                            <td>@product.Category</td>
                            <td>@product.TaxCategory</td>
                            <td>@product.Price.ToString("C2", inr)</td>
                            <td>@product.QuantityOnHand</td>
                            <td><input class="form-control form-control-sm" type="number" name="Quantities[@product.ProductId]" value="0" min="0" max="@product.QuantityOnHand" step="1" aria-label="Quantity for @product.Name" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="row g-3">
                <div class="col-md-3"><label for="TerminalId" class="form-label">Counter terminal</label><select id="TerminalId" name="TerminalId" class="form-select" required><option value="">Select terminal</option>@foreach (var terminal in Model.Register.Terminals) { <option value="@terminal.Id">@terminal.Code — @terminal.Name</option> }</select></div>
                <div class="col-md-4">
                    <label for="ShippingRateId" class="form-label">Shipping service (optional)</label>
                    <select id="ShippingRateId" name="ShippingRateId" class="form-select">
                        <option value="">No shipping service</option>
                        @foreach (var schedule in Model.Register.ShippingSchedules)
                        {
                            @foreach (var rate in schedule.Rates.Where(rate => rate.IsActive))
                            {
                                <option value="@rate.Id">@schedule.Zone.Name — @rate.ServiceLevel</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3"><label for="ShipmentType" class="form-label">Shipment type</label><select id="ShipmentType" name="ShipmentType" class="form-select"><option value="">Select type</option><option value="Parcel">Parcel</option><option value="Letter">Letter</option></select></div>
                <div class="col-md-3"><label for="ShippingWeightKilograms" class="form-label">Shipment weight (kg)</label><input id="ShippingWeightKilograms" name="ShippingWeightKilograms" type="number" min="0.01" step="0.01" class="form-control" /></div>
                <div class="col-md-4"><label for="ShippingRecipientName" class="form-label">Recipient name</label><input id="ShippingRecipientName" name="ShippingRecipientName" maxlength="100" class="form-control" /></div>
                <div class="col-md-8"><label for="ShippingAddress" class="form-label">Destination address</label><textarea id="ShippingAddress" name="ShippingAddress" maxlength="300" rows="2" class="form-control"></textarea></div>
                <div class="col-12" data-parcel-dimensions><span class="form-label">Parcel dimensions (parcels only)</span><div class="row g-2"><div class="col-md-2"><label for="ParcelLengthCentimeters" class="form-label">Length (cm)</label><input id="ParcelLengthCentimeters" name="ParcelLengthCentimeters" type="number" min="0.01" step="0.01" class="form-control" /></div><div class="col-md-2"><label for="ParcelWidthCentimeters" class="form-label">Width (cm)</label><input id="ParcelWidthCentimeters" name="ParcelWidthCentimeters" type="number" min="0.01" step="0.01" class="form-control" /></div><div class="col-md-2"><label for="ParcelHeightCentimeters" class="form-label">Height (cm)</label><input id="ParcelHeightCentimeters" name="ParcelHeightCentimeters" type="number" min="0.01" step="0.01" class="form-control" /></div></div></div>
                <div class="col-12"><h4 class="h6 mb-0">Optional money order</h4><small class="text-muted">The order principal and configured @Model.MoneyOrderFee.ToString("C2", inr) fee are included in this receipt total. Identity verification is required above @Model.MoneyOrderIdentityVerificationThreshold.ToString("C2", inr).</small></div>
                <div class="col-md-3"><label for="MoneyOrderAmount" class="form-label">Money order amount</label><input id="MoneyOrderAmount" name="MoneyOrderAmount" type="number" min="0.01" max="10000000" step="0.01" class="form-control" /></div>
                <div class="col-md-3"><label for="MoneyOrderSenderName" class="form-label">Money order sender</label><input id="MoneyOrderSenderName" name="MoneyOrderSenderName" maxlength="100" class="form-control" /></div>
                <div class="col-md-3"><label for="MoneyOrderRecipientName" class="form-label">Money order recipient</label><input id="MoneyOrderRecipientName" name="MoneyOrderRecipientName" maxlength="100" class="form-control" /></div>
                <div class="col-md-3"><label for="MoneyOrderDocumentType" class="form-label">Identity document (if required)</label><select id="MoneyOrderDocumentType" name="MoneyOrderDocumentType" class="form-select"><option value="">Select if prompted</option><option value="NationalId">National ID</option><option value="Passport">Passport</option><option value="DrivingLicence">Driving licence</option></select></div>
                <div class="col-md-4"><label for="MoneyOrderDocumentIdentifier" class="form-label">Document identifier</label><input id="MoneyOrderDocumentIdentifier" name="MoneyOrderDocumentIdentifier" maxlength="40" autocomplete="off" class="form-control" /></div>
                <div class="col-md-3"><label for="PaymentMethod" class="form-label">Payment method</label><select id="PaymentMethod" name="PaymentMethod" class="form-select"><option value="Cash">Cash</option><option value="Card">Card</option><option value="DigitalWallet">Digital wallet</option></select></div>
                <div class="col-12"><button type="submit" class="btn btn-primary">Complete transaction</button><span class="ms-2 text-muted small">Payment is recorded for this training workflow; no external payment is processed.</span></div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info">You can review transactions for this branch. Your role cannot complete sales.</div>
    }

    <h3 class="h5">Recent transactions</h3>
    @if (Model.Register.RecentTransactions.Count == 0)
    {
        <p class="text-muted">No transactions have been recorded for this branch.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table table-striped">
            <thead><tr><th>Receipt</th><th>Terminal</th><th>Time</th><th>Items / label</th><th>Payment</th><th>Status</th><th class="text-end">Tax</th><th class="text-end">Total</th>@if (User.IsInRole("BranchManager")) { <th>Manager action</th> }</tr></thead>
            <tbody>
            @foreach (var transaction in Model.Register.RecentTransactions)
            {
                <tr>
                    <td>@transaction.TransactionNumber</td>
                    <td>@(Model.Register.Terminals.FirstOrDefault(terminal => terminal.Id == transaction.TerminalId)?.Code ?? "Legacy")</td>
                    <td>@transaction.OccurredAt.ToLocalTime().ToString("g")</td>
                    <td>@transaction.Lines.Count product line(s)@(transaction.ShippingRateId is not null ? $" + {transaction.ShippingServiceLevel} shipping" : "")@(transaction.MoneyOrderId is not null ? $" + money order {transaction.MoneyOrderAmount.ToString("C2", inr)}" : "")
                        @if (transaction.ShippingRecipientName is not null)
                        {
                            <span class="d-block small">@transaction.ShipmentType shipment</span><a class="d-block small" asp-action="Label" asp-route-id="@transaction.Id" asp-route-branchId="@Model.SelectedBranchId">Preview label</a>
                        }
                    </td>
                    <td>@transaction.PaymentMethod</td>
                    <td>@transaction.Status @if (transaction.ResolvedAt is not null) { <small class="text-muted d-block">@transaction.ResolutionReason</small> }</td>
                    <td class="text-end">@transaction.TaxTotal.ToString("C2", inr)</td>
                    <td class="text-end">@transaction.TotalAmount.ToString("C2", inr)</td>
                    @if (User.IsInRole("BranchManager"))
                    {
                        <td>
                            @if (transaction.Status is TransactionStatus.Paid or TransactionStatus.Completed)
                            {
                                <form asp-action="Reverse" method="post" class="d-flex gap-1 align-items-start">
                                    <input type="hidden" name="TransactionId" value="@transaction.Id" />
                                    <input class="form-control form-control-sm" name="Reason" maxlength="250" minlength="3" required placeholder="Reason" aria-label="Reason for @transaction.TransactionNumber reversal" />
                                    @if (transaction.MoneyOrderId is null) { <button class="btn btn-sm btn-outline-warning" name="IsRefund" value="false" type="submit">Void</button> }
                                    <button class="btn btn-sm btn-outline-danger" name="IsRefund" value="true" type="submit">Refund</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Resolved</span>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table></div>
    }
}
