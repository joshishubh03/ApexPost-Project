@model UpdateStaffInputModel
@using ApexPost.Domain.Entities
@using ApexPost.Domain.Enums
@{
    ViewData["Title"] = "Edit staff account";
    var branches = ViewData["Branches"] as IReadOnlyList<Branch> ?? [];
}

<h1>Edit staff account</h1>
<p class="text-muted">Update the staff member's contact details, role, and home branch.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="card card-body" style="max-width: 42rem">
    <form asp-action="UpdateStaff" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" asp-items="Html.GetEnumSelectList<StaffRole>()" class="form-select"></select><span asp-validation-for="Role" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="BranchId" class="form-label">Home branch</label><select asp-for="BranchId" class="form-select"><option value="">No branch</option>@foreach (var branch in branches) { <option value="@branch.Id">@branch.Code — @branch.Name</option> }</select><span asp-validation-for="BranchId" class="text-danger"></span><div class="form-text">A home branch is required for non-administrator roles.</div></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Save changes</button><a asp-action="Staff" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
