@model ShippingPageModel
@using ApexPost.Domain.Enums
@{
    ViewData["Title"] = "Shipping zones and rates";
    var canManage = User.IsInRole("Administrator");
    var inr = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
}

<h1>Shipping zones and rates</h1>
<p class="text-muted">Rates use a base charge plus a per-kilogram amount, up to the configured maximum weight.</p>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="card card-body mb-4">
    <h2 class="h5">Get a shipping quote</h2>
    @if (Model.ActiveRates.Count == 0)
    {
        <p class="mb-0">No active shipping rates are available.</p>
    }
    else
    {
        <form asp-action="Quote" method="post" class="row g-3 align-items-end">
            <div class="col-md-6"><label asp-for="QuoteInput.RateId" class="form-label">Zone and service</label><select asp-for="QuoteInput.RateId" class="form-select"><option value="">Select a rate</option>@foreach (var schedule in Model.Schedules.Where(schedule => schedule.Zone.IsActive)) { foreach (var rate in schedule.Rates.Where(rate => rate.IsActive)) { <option value="@rate.Id">@schedule.Zone.Name — @rate.ServiceLevel</option> } }</select></div>
            <div class="col-md-3"><label asp-for="QuoteInput.WeightKilograms" class="form-label">Weight (kg)</label><input asp-for="QuoteInput.WeightKilograms" class="form-control" type="number" min="0.01" max="30" step="0.01" /><span asp-validation-for="QuoteInput.WeightKilograms" class="text-danger"></span></div>
            <div class="col-auto"><button class="btn btn-primary" type="submit">Calculate quote</button></div>
        </form>
        @if (Model.Quote is not null)
        {
            <div class="alert alert-info mt-3 mb-0">@Model.Quote.ServiceLevel to @Model.Quote.ZoneName for @Model.Quote.WeightKilograms.ToString("0.##") kg: <strong>@Model.Quote.Price.ToString("C2", inr)</strong></div>
        }
    }
</div>

@if (canManage)
{
    <div class="row g-4 mb-4">
        <section class="col-lg-5">
            <div class="card card-body h-100">
                <h2 class="h5">Add shipping zone</h2>
                <form asp-action="CreateZone" method="post">
                    <div class="mb-3"><label asp-for="NewZone.Code" class="form-label"></label><input asp-for="NewZone.Code" class="form-control" /><span asp-validation-for="NewZone.Code" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="NewZone.Name" class="form-label"></label><input asp-for="NewZone.Name" class="form-control" /><span asp-validation-for="NewZone.Name" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="NewZone.Destination" class="form-label"></label><input asp-for="NewZone.Destination" class="form-control" /><span asp-validation-for="NewZone.Destination" class="text-danger"></span></div>
                    <button class="btn btn-outline-primary" type="submit">Create zone</button>
                </form>
            </div>
        </section>
        <section class="col-lg-7">
            <div class="card card-body h-100">
                <h2 class="h5">Add rate</h2>
                @if (Model.ActiveZones.Count == 0)
                {
                    <p>Create a zone before adding rates.</p>
                }
                else
                {
                    <form asp-action="CreateRate" method="post">
                        <div class="mb-3"><label asp-for="NewRate.ZoneId" class="form-label">Zone</label><select asp-for="NewRate.ZoneId" class="form-select"><option value="">Select a zone</option>@foreach (var zone in Model.ActiveZones) { <option value="@zone.Id">@zone.Code — @zone.Name</option> }</select><span asp-validation-for="NewRate.ZoneId" class="text-danger"></span></div>
                        <div class="row g-2">
                            <div class="col-md-3 mb-3"><label asp-for="NewRate.ServiceLevel" class="form-label"></label><select asp-for="NewRate.ServiceLevel" asp-items="Html.GetEnumSelectList<ShippingServiceLevel>()" class="form-select"></select></div>
                            <div class="col-md-3 mb-3"><label asp-for="NewRate.BasePrice" class="form-label">Base (INR)</label><input asp-for="NewRate.BasePrice" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="NewRate.BasePrice" class="text-danger"></span></div>
                            <div class="col-md-3 mb-3"><label asp-for="NewRate.PricePerKilogram" class="form-label">Per kg (INR)</label><input asp-for="NewRate.PricePerKilogram" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="NewRate.PricePerKilogram" class="text-danger"></span></div>
                            <div class="col-md-3 mb-3"><label asp-for="NewRate.MaximumWeightKilograms" class="form-label">Max weight (kg)</label><input asp-for="NewRate.MaximumWeightKilograms" class="form-control" type="number" min="0.01" max="30" step="0.01" /><span asp-validation-for="NewRate.MaximumWeightKilograms" class="text-danger"></span></div>
                        </div>
                        <button class="btn btn-outline-primary" type="submit">Create rate</button>
                    </form>
                }
            </div>
        </section>
    </div>
}

<h2 class="h4">Rate schedule</h2>
@foreach (var schedule in Model.Schedules)
{
    <section class="card card-body mb-3">
        <div class="d-flex justify-content-between"><h3 class="h5">@schedule.Zone.Code — @schedule.Zone.Name</h3><span class="badge @(schedule.Zone.IsActive ? "text-bg-success" : "text-bg-secondary")">@(schedule.Zone.IsActive ? "Active" : "Inactive")</span></div>
        <p class="text-muted">@schedule.Zone.Destination</p>
        @if (schedule.Rates.Count == 0)
        {
            <p class="mb-0">No rates configured.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Service</th><th>Base charge</th><th>Per kg</th><th>Maximum weight</th><th>Status</th></tr></thead><tbody>
            @foreach (var rate in schedule.Rates)
            {
                <tr><td>@rate.ServiceLevel</td><td>@rate.BasePrice.ToString("C2", inr)</td><td>@rate.PricePerKilogram.ToString("C2", inr)</td><td>@rate.MaximumWeightKilograms.ToString("0.##") kg</td><td>@(rate.IsActive ? "Active" : "Inactive")</td></tr>
            }
            </tbody></table></div>
        }
    </section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
