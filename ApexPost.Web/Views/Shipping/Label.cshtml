@model ApexPost.Domain.Entities.CounterTransaction
@{
    ViewData["Title"] = "Shipping label";
}

<div class="d-flex justify-content-between align-items-center mb-3 label-controls">
    <div>
        <h1 class="h3 mb-1">Shipping label preview</h1>
        <p class="text-muted mb-0">Print this page from your browser when the shipment is ready.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="CounterTransactions" asp-action="Index" asp-route-branchId="@Model.BranchId">Back to counter</a>
</div>

<section class="card label-card" aria-label="Shipping label">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
            <div><div class="text-muted small">APEXPOST</div><strong>PARCEL SERVICE</strong></div>
            <div class="text-end"><div class="text-muted small">Tracking number</div><strong class="fs-5">@Model.TransactionNumber</strong></div>
        </div>
        <div class="row g-4">
            <div class="col-md-7">
                <div class="text-muted small text-uppercase">Ship to</div>
                <strong>@Model.ShippingRecipientName</strong>
                <address class="mt-1 mb-0">@Model.ShippingAddress</address>
            </div>
            <div class="col-md-5 text-md-end">
                <div class="text-muted small text-uppercase">Service</div>
                <strong>@Model.ShippingZoneName — @Model.ShippingServiceLevel</strong>
                <div>@Model.ShippingWeightKilograms?.ToString("0.##") kg</div>
                <div>@Model.ParcelLengthCentimeters?.ToString("0.##") × @Model.ParcelWidthCentimeters?.ToString("0.##") × @Model.ParcelHeightCentimeters?.ToString("0.##") cm</div>
            </div>
        </div>
        <div class="border-top mt-4 pt-3 d-flex justify-content-between small text-muted">
            <span>Receipt @Model.TransactionNumber</span>
            <span>Accepted @Model.OccurredAt.ToLocalTime().ToString("g")</span>
        </div>
    </div>
</section>

<style>
    @@media print {
        .label-controls, nav, footer { display: none !important; }
        .label-card { border: 2px solid #222 !important; box-shadow: none !important; }
        body { background: white !important; }
    }
</style>
