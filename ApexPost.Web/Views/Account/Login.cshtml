@model ApexPost.Web.Models.LoginInputModel
@{
    ViewData["Title"] = "Staff sign in";
}

<div>
    <p>APEXPOST COUNTER PLATFORM</p>
    <h1 id="login-heading">Staff sign in</h1>
    <p>Sign in with the account assigned to you by your branch administrator.</p>
    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>

        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>

        <div>
            <label>
                <input asp-for="RememberMe" type="checkbox" />
                Keep me signed in
            </label>
        </div>

        <button type="submit">Sign in</button>
    </form>
    <p>For authorized ApexPost staff use only.</p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
