{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "SqlServer",
    "CommandTimeoutSeconds": 30,
    "ApplyMigrationsOnStartup": true
  },
  "ConnectionStrings": {
    "ApexPost": "Server=localhost;Database=ApexPostCounter;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Security": {
    "MaintenanceMode": false,
    "MaintenanceRetryAfterSeconds": 300,
    "AdminAllowedIpAddresses": [
      "127.0.0.1",
      "::1"
    ],
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "IntegrationAllowedIpAddresses": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Diagnostics": {
    "SlowActionThresholdMilliseconds": 1000
  },
  "PartnerApi": {
    "AllowedCorsOrigins": [],
    "Partners": {}
  },
  "CourierTracking": {
    "ProviderBaseUrl": "",
    "TrackingPath": "api/tracking",
    "MaximumConcurrency": 3,
    "TimeoutSeconds": 2,
    "SimulatedLatencyMilliseconds": 40
  },
  "Taxation": {
    "Rates": {
      "Standard": 0,
      "Shipping": 0
    }
  },
  "MoneyOrders": {
    "IdentityVerificationThreshold": 10000,
    "FeeAmount": 50,
    "DemoVerificationSuccessPrefix": "DEMO-VALID-"
  }
}
