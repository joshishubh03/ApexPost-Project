    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT access token with the courierId claim and the Courier or Admin role. Development: GET /dev/token?roles=Courier\u0026courierId=courier-007",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "PartnerApiKey": {
