                }
              }
            }
          },
          "404": {
            "description": "Unknown tracking number.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "PartnerApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CourierScanType": {
        "enum": [
          "Pickup",
          "InTransit",
          "Delivered",
          "Failed",
          null
        ]
      },
      "CourierShipmentStatus": {
        "enum": [
          "Created",
          "PickedUp",
          "InTransit",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ]
      },
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "city"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-\\d{8}$",
            "type": "string",
            "description": "Tracking number, APX- followed by 8 digits (e.g. APX-10000001)."
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Parcel weight in kilograms, 0.1 to 70.",
            "format": "decimal"
          },
          "recipientName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "description": "Recipient full name."
          },
          "recipientPhone": {
            "pattern": "^\\\u002B?[1-9]\\d{6,14}$",
            "type": "string",
            "description": "Recipient phone in E.164 format, e.g. \u002B15550100123."
          },
          "recipientAddress": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "description": "Street address."
          },
          "city": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "description": "Destination city (used by the list filter)."
          }
        },
        "description": "Body of POST /shipments. Never bound to an EF entity - mapped to a command by the controller."
      },
      "LatestScanResponse": {
        "required": [
          "scanType",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanType": {
            "$ref": "#/components/schemas/CourierScanType"
          },
          "location": {
            "type": "string",
            "description": "Where the scan happened."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "When the scan happened (UTC).",
            "format": "date-time"
          }
        },
        "description": "Summary of the latest scan (v2)."
      },
      "PartnerShipmentResponse": {
        "required": [
          "trackingNumber",
          "status",
          "destinationCity",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "description": "Tracking number."
          },
          "status": {
            "$ref": "#/components/schemas/CourierShipmentStatus"
          },
          "destinationCity": {
            "type": "string",
            "description": "Destination city only."
          },
          "latestScan": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/LatestScanResponse"
              }
            ]
          },
          "updatedAtUtc": {
            "type": "string",
            "description": "When the shipment last changed (UTC).",
            "format": "date-time"
          }
        },
        "description": "Partner view of a shipment: no recipient name, phone or address."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RecipientResponse": {
        "required": [
          "name",
          "phone",
          "address",
          "city"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name."
          },
          "phone": {
            "type": "string",
            "description": "Phone number (E.164)."
          },
          "address": {
            "type": "string",
            "description": "Street address."
          },
          "city": {
            "type": "string",
            "description": "City."
          }
        },
        "description": "Recipient details (v2)."
      },
      "RejectedScanResponse": {
        "required": [
          "scanId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "Device scan ID, scan::{Guid}."
          },
          "reason": {
            "type": "string",
            "description": "Why the scan was rejected."
          }
        },
        "description": "A scan that was not stored."
      },
      "ScanResponse": {
        "required": [
          "scanId",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc",
          "receivedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "Device scan ID, scan::{Guid}."
          },
          "scanType": {
            "$ref": "#/components/schemas/CourierScanType"
          },
          "courierId": {
            "type": "string",
            "description": "Courier who took the scan."
          },
          "location": {
            "type": "string",
            "description": "Where the scan happened."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "When the scan happened (UTC).",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "description": "Courier notes.",
            "nullable": true
          },
          "signatureName": {
            "type": "string",
            "description": "Signature name for a Delivered scan.",
            "nullable": true
          },
          "receivedAtUtc": {
            "type": "string",
            "description": "When the server stored the scan (UTC).",
            "format": "date-time"
          }
        },
        "description": "A stored scan."
      },
      "ScanUploadItemRequest": {
        "required": [
          "scanId",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "pattern": "^scan::[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string",
            "description": "The device document ID, scan::{Guid}. The server de-duplicates on it."
          },
          "scanType": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/CourierScanType"
              }
            ]
          },
          "courierId": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string",
            "description": "Courier who took the scan."
          },
          "location": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "description": "Where the scan happened."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "When the scan happened (UTC). Custom rule: cannot be in the future.",
            "format": "date-time",
            "nullable": true
          },
          "notes": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Optional courier notes.",
            "nullable": true
          },
          "signatureName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "description": "Name of the person who signed. Custom rule: required for a Delivered scan.",
            "nullable": true
          }
        },
        "description": "One offline scan."
      },
      "ScanUploadRequest": {
        "required": [
          "scans"
        ],
        "type": "object",
        "properties": {
          "scans": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanUploadItemRequest"
            },
            "description": "1 to 100 scans. Re-sending a scan ID that is already stored is safe: it is skipped, not duplicated."
          }
        },
        "description": "Body of POST /shipments/{trackingNumber}/scans: offline scans from the courier device (Part A)."
      },
      "ScanUploadResponse": {
        "required": [
          "accepted",
          "duplicatesSkipped",
          "rejected"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "New scans stored.",
            "format": "int32"
          },
          "duplicatesSkipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Scans whose ID was already stored (or repeated in the batch): skipped, not duplicated.",
            "format": "int32"
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RejectedScanResponse"
            },
            "description": "Scans refused by a business rule, with the reason."
          }
        },
        "description": "Result of an idempotent scan upload."
      },
      "ShipmentPageResponseV2": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentResponseV2"
            },
            "description": "The shipments on this page, newest first."
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "1-based page number.",
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Requested page size.",
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Number of shipments matching the filter.",
            "format": "int32"
          },
          "totalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Number of pages.",
            "format": "int32"
          }
        },
        "description": "One page of v2 shipments."
      },
      "ShipmentResponseV2": {
        "required": [
          "trackingNumber",
          "status",
          "weightKg",
          "recipient",
          "createdAtUtc",
          "updatedAtUtc"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "description": "Tracking number, e.g. APX-10000001."
          },
          "status": {
            "$ref": "#/components/schemas/CourierShipmentStatus"
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Weight in kilograms.",
            "format": "decimal"
          },
          "recipient": {
            "$ref": "#/components/schemas/RecipientResponse"
          },
          "latestScan": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/LatestScanResponse"
              }
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "description": "When the shipment was created (UTC).",
            "format": "date-time"
          },
          "updatedAtUtc": {
            "type": "string",
            "description": "When the shipment last changed (UTC).",
            "format": "date-time"
          }
        },
        "description": "A shipment (v2). Breaking changes from v1: recipient fields are nested in RecipientResponse ShipmentResponseV2.Recipient, a\r\nLatestScanResponse? ShipmentResponseV2.LatestScan summary is added and CourierShipmentStatus ShipmentResponseV2.Status is a string enum."
      },
      "UpdateShipmentRequest": {
        "required": [
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "city"
        ],
        "type": "object",
        "properties": {
          "weightKg": {
            "maximum": 70,
