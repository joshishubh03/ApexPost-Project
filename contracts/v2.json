        "tags": [
          "Partner"
        ],
        "summary": "Tracking status of one shipment for a partner (requires the X-Api-Key header).",
        "operationId": "GetPartnerShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
