{
  "openapi": "3.0.4",
  "info": {
    "title": "ApexPost Logistics API",
    "description": "ApexPost courier shipments and scans - version 2. Recipient grouped in a nested object, latestScan summary, status as a string enum. Errors are RFC 9457 Problem Details.",
    "contact": {
      "name": "ApexPost Platform API Team",
      "url": "https://developer.apexpost.example/api",
      "email": "api-team@apexpost.example"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://localhost/"
    }
  ],
  "paths": {
    "/api/v2/shipments/{trackingNumber}/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Uploads offline scans from the courier device. Idempotent: a scan ID that is already stored (or repeated in\r\nthe batch) is counted in duplicatesSkipped and never stored twice, so the app can safely retry.",
        "operationId": "UploadScans",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "APX-######## tracking number.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Request abort token.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Not a Courier, or a scan uses another courier\u0027s ID.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Counts of accepted, duplicate and rejected scans (with reasons).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure (for example a scan in the future, or Delivered without a signature).",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tracking number.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Scan history for a shipment, oldest first.",
        "operationId": "GetScanHistory",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "APX-######## tracking number.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The scans.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown tracking number.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v2/shipments": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "summary": "Lists shipments (v2), newest first, with paging and optional status/city filters.",
        "operationId": "ListShipments",
        "parameters": [
          {
            "name": "Page",
            "in": "query",
            "description": "1-based page number.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Items per page (default 20, maximum 50).",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "description": "Optional status filter.",
            "schema": {
              "$ref": "#/components/schemas/CourierShipmentStatus"
            }
          },
          {
            "name": "City",
            "in": "query",
            "description": "Optional city filter (exact match).",
            "schema": {
              "maxLength": 80,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "One page of shipments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPageResponseV2"
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging or filter values.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Creates a shipment in status Created.",
        "operationId": "CreateShipment",
        "requestBody": {
          "description": "Request abort token.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Admin role required.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created; the Location header points to the new shipment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseV2"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The tracking number already exists.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
