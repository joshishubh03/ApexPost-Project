            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Parcel weight in kilograms, 0.1 to 70.",
            "format": "decimal"
          },
          "recipientName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string",
            "description": "Recipient full name."
          },
          "recipientPhone": {
            "pattern": "^\\\u002B?[1-9]\\d{6,14}$",
            "type": "string",
            "description": "Recipient phone in E.164 format."
          },
          "recipientAddress": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "description": "Street address."
          },
          "city": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "description": "Destination city."
          }
        },
        "description": "Body of PUT /shipments/{trackingNumber}: replaces the editable details (weight and recipient)."
      },
      "UpdateStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "enum": [
                  null
                ],
                "nullable": true
              },
              {
                "$ref": "#/components/schemas/CourierShipmentStatus"
