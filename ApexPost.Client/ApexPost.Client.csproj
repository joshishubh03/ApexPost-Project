<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Week 4 Part C: typed C# client generated by NSwag from contracts/v2.json.
    Exact generator config: nswag.json (+ the NSwag version pinned in .config/dotnet-tools.json).
    The GenerateApexPostClient target below re-runs NSwag whenever nswag.json or contracts/v2.json changes, so the
    committed Generated/ApexPostApiClient.g.cs always matches the contract. Never edit the generated file by hand:
    put additions in partial classes (ApexPostApiClient.Extensions.cs) or wrappers.
    Manual equivalent:  dotnet tool restore ; cd ApexPost.Client ; dotnet tool run nswag run nswag.json
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ApexPost.Client</RootNamespace>
    <!-- Generated code is not held to the solution's warnings-as-errors policy. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0108;CS0114;CS0472;CS0612;CS0618;CS1573;CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="nswag.json" />
    <None Include="..\contracts\v2.json" Link="contracts\v2.json" />
  </ItemGroup>

  <Target Name="GenerateApexPostClient"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipClientGeneration)' != 'true'"
          Inputs="nswag.json;..\contracts\v2.json"
          Outputs="Generated\ApexPostApiClient.g.cs">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory).." />
    <!-- NSwag 14 targets .NET 8/9; roll forward so it also runs on a machine with only the .NET 10 runtime. -->
    <Exec Command="dotnet tool run nswag run nswag.json" WorkingDirectory="$(MSBuildThisFileDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <!-- On a clean checkout the generated file does not exist at evaluation time; add it once NSwag has written it. -->
  <Target Name="IncludeGeneratedApexPostClient" AfterTargets="GenerateApexPostClient" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="Generated\ApexPostApiClient.g.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
