      Executed DbCommand (29ms) [Parameters=[@fromUtc='?' (Scale = 3) (DbType = DateTimeOffset), @toUtc='?' (Scale = 3) (DbType = DateTimeOffset)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT [b].[Code], [b].[Name], [b].[Region]&#xD;
      FROM [Branches] AS [b]&#xD;
      WHERE NOT EXISTS (&#xD;
          SELECT 1&#xD;
          FROM [CounterTransactions] AS [c]&#xD;
