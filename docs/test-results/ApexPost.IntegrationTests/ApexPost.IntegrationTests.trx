      Executed DbCommand (1ms) [Parameters=[@p='?' (DbType = Int32), @branchId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT [t].[Id], [t].[CounterTransactionId], [t].[LineNumber], [t].[LineTotal], [t].[ProductId], [t].[ProductName], [t].[Quantity], [t].[Sku], [t].[TaxAmount], [t].[TaxCategory], [t].[TaxRatePercent], [t].[UnitPrice], [c0].[Id], [p].[Id], [s].[Id]&#xD;
      FROM (&#xD;
          SELECT TOP(@p) [c].[Id], [c].[OccurredAt]&#xD;
          FROM [CounterTransactions] AS [c]&#xD;
          WHERE [c].[BranchId] = @branchId&#xD;
          ORDER BY [c].[OccurredAt] DESC&#xD;
      ) AS [c0]&#xD;
      LEFT JOIN [Payments] AS [p] ON [c0].[Id] = [p].[CounterTransactionId]&#xD;
      LEFT JOIN [Shipments] AS [s] ON [c0].[Id] = [s].[CounterTransactionId]&#xD;
      INNER JOIN [TransactionLines] AS [t] ON [c0].[Id] = [t].[CounterTransactionId]&#xD;
      ORDER BY [c0].[OccurredAt] DESC, [c0].[Id], [p].[Id], [s].[Id]&#xD;
